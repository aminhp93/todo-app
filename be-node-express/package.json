{
  "name": "be-node-express",
  "version": "1.0.0",
  "description": "Express backend with Postgres",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
